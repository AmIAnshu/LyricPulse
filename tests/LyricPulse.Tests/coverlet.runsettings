<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[LyricPulse.Core]WinRT.*,[LyricPulse.Core]System.Text.RegularExpressions.Generated.*,[LyricPulse.Core]LyricPulse.Core.Serialization.*,[LyricPulse.Core]LyricPulse.Core.CoreLogMessages,[LyricPulse.Rendering]LyricPulse.Rendering.RenderingLogMessages</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
