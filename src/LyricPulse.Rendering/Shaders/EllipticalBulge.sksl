uniform shader content;
uniform float2 iCenter;
uniform float2 iSize;
uniform float  iStrength;
uniform float  iPower;

half4 main(float2 fragCoord) {
    float2 halfSize = max(iSize * 0.5, float2(1.0));
    float2 d = fragCoord - iCenter;
    float2 norm = d / halfSize;
    float r = length(norm);

    // Guard pow(0.0, iPower) against ANGLE D3D11 / GLSL ES undefined behavior
    // Clamp r <= 1.0 and strength <= 0.30 so radial warp stays strictly monotonic (f'(r) > 0, zero fold-back)
    float rClamped = min(r, 1.0);
    float radial = (rClamped > 0.0001) ? pow(rClamped, iPower) : 0.0;

    // LOCKED CONVEX BULGE SIGN: factor < 1 samples closer to center -> true convex outward magnification
    float clampedStrength = clamp(abs(iStrength), 0.0, 0.30);
    float factor = max(1.0 - clampedStrength * radial, 0.15);
    float2 samplePos = iCenter + d * factor;

    // Smooth transparent border feather guarantees strictly alpha == 0 at all 4 offscreen corners
    // (0.975 outer threshold covers pixel centers at (0.5, 0.5) even on compact 64x64 layers)
    float borderMetric = max(abs(norm.x), abs(norm.y));
    float edgeFade = 1.0 - smoothstep(0.84, 0.975, borderMetric);
    if (edgeFade <= 0.001) {
        return half4(0.0);
    }

    return content.eval(samplePos) * half(edgeFade);
}
