uniform float2 iResolution;
uniform float  iTime;
uniform float  iEnergy;
uniform float3 iColor1;
uniform float3 iColor2;
uniform float3 iColor3;
uniform float  iBass;
uniform float  iBottomFade;

float hash12(float2 p) {
    float3 p3 = fract(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

half4 main(float2 fragCoord) {
    float2 res = max(iResolution, float2(1.0));
    float2 uv = fragCoord / res;
    float aspect = res.x / res.y;
    float2 p = float2((uv.x - 0.5) * aspect, uv.y - 0.5);

    float energy = clamp(iEnergy, 0.5, 1.85);
    float bass = clamp(iBass, 0.0, 1.0);
    float t = iTime * (0.60 + 0.32 * min(energy, 1.5));

    // Verci-inspired lush overlapping dual-tone aurora clouds with gentle bass breathing
    float2 orb1 = float2(-0.24 * aspect + sin(t * 0.21) * 0.24 * aspect, -0.08 + cos(t * 0.17) * 0.18);
    float2 orb2 = float2( 0.26 * aspect + cos(t * 0.27 + 1.6) * 0.22 * aspect,  0.10 + sin(t * 0.23 + 0.9) * 0.20);
    float2 orb3 = float2(sin(t * 0.15 + 3.4) * 0.30 * aspect, -0.18 + cos(t * 0.19 + 2.2) * 0.18);

    float spread = 1.0 - (bass * 0.18);
    float d1 = length(p - orb1) * spread;
    float d2 = length(p - orb2) * spread;
    float d3 = length(p - orb3) * spread;

    float w1 = exp(-d1 * d1 * 1.45) * (0.58 + 0.16 * energy + 0.18 * bass);
    float w2 = exp(-d2 * d2 * 1.60) * (0.54 + 0.14 * energy + 0.16 * bass);
    float w3 = exp(-d3 * d3 * 2.00) * (0.36 + 0.10 * energy);

    // Rich ambient base gradient across the canvas so corners feel luminous, not dead black
    float diag = clamp(uv.x * 0.55 + (1.0 - uv.y) * 0.45, 0.0, 1.0);
    float wave = 0.5 + 0.5 * sin((p.x * 2.1 - p.y * 1.6) + t * 0.40);
    float3 deepObsidian = float3(0.036, 0.040, 0.062);
    float3 baseWash = mix(iColor2, iColor1, diag) * (0.19 + 0.06 * energy);

    float3 meshColor = deepObsidian + baseWash
        + iColor1 * (w1 * (0.86 + 0.14 * wave))
        + iColor2 * (w2 * (0.90 + 0.10 * (1.0 - wave)))
        + iColor3 * w3;

    // Gentle studio edge vignette (preserves colorful corners while framing hero typography)
    float radial = length((uv - float2(0.5)) * float2(1.05, 1.15));
    float vignette = 1.0 - smoothstep(0.45, 1.25, radial) * 0.38;
    meshColor *= vignette;

    // Verci-style seamless bottom fade-to-black in windowed Studio mode (disabled in F11 Fullscreen & cards)
    if (iBottomFade > 0.5) {
        float fadeMask = 1.0 - smoothstep(0.72, 0.995, uv.y);
        meshColor *= fadeMask;
    }

    // Fine anti-banding analog photographic grain (~3.2% amplitude)
    float grain = (hash12(fragCoord + fract(iTime * 0.33) * 23.0) - 0.5) * 0.032;
    if (iBottomFade > 0.5 && uv.y > 0.94) {
        grain *= 1.0 - smoothstep(0.94, 1.0, uv.y);
    }

    meshColor = clamp(meshColor + float3(grain), float3(0.0), float3(1.0));
    return half4(half3(meshColor), 1.0);
}
