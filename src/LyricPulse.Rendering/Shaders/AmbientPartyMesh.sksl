uniform float2 iResolution;
uniform float  iTime;
uniform float  iEnergy;
uniform float3 iColor1;
uniform float3 iColor2;
uniform float3 iColor3;

float hash12(float2 p) {
    float3 p3 = fract(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

half4 main(float2 fragCoord) {
    float2 res = max(iResolution, float2(1.0));
    float2 uv = fragCoord / res;
    float aspect = res.x / res.y;
    float2 p = float2((uv.x - 0.5) * aspect, uv.y - 0.5);

    float energy = clamp(iEnergy, 0.5, 1.85);
    float t = iTime * (0.65 + 0.35 * min(energy, 1.5));

    // Three slowly drifting aurora orbs creating a rich concert atmosphere
    float2 orb1 = float2(sin(t * 0.23) * 0.42 * aspect, cos(t * 0.19) * 0.28 - 0.06);
    float2 orb2 = float2(cos(t * 0.31 + 1.9) * 0.38 * aspect, sin(t * 0.27 + 0.8) * 0.30 + 0.08);
    float2 orb3 = float2(sin(t * 0.17 + 3.7) * 0.34 * aspect, cos(t * 0.21 + 2.4) * 0.26);

    float d1 = length(p - orb1);
    float d2 = length(p - orb2);
    float d3 = length(p - orb3);

    float w1 = exp(-d1 * d1 * 2.25) * (0.44 + 0.14 * energy);
    float w2 = exp(-d2 * d2 * 2.55) * (0.40 + 0.12 * energy);
    float w3 = exp(-d3 * d3 * 2.85) * (0.30 + 0.08 * energy);

    // Subtle organic wave shimmer linking the aurora fields
    float wave = 0.5 + 0.5 * sin((p.x * 2.4 - p.y * 1.8) + t * 0.45);
    float3 baseObsidian = float3(0.031, 0.035, 0.051);
    float3 meshColor = baseObsidian
        + iColor1 * (w1 * (0.85 + 0.15 * wave))
        + iColor2 * (w2 * (0.90 + 0.10 * (1.0 - wave)))
        + iColor3 * w3;

    // Gentle radial concert vignette keeps hero lyrics high-contrast at viewport center
    float radial = length((uv - float2(0.5)) * float2(1.15, 1.25));
    float vignette = 1.0 - smoothstep(0.32, 1.08, radial) * 0.58;
    meshColor *= vignette;

    // Subtle anti-banding organic film grain (~2.5% amplitude)
    float grain = (hash12(fragCoord + fract(iTime * 0.37) * 19.0) - 0.5) * 0.026;
    meshColor = clamp(meshColor + float3(grain), float3(0.0), float3(1.0));

    return half4(half3(meshColor), 1.0);
}
