uniform shader content;
uniform float2 iVelocity;

half4 main(float2 fragCoord) {
    half4 accum = half4(0.0);
    float weightSum = 0.0;

    // Fixed 13-tap compile-time constant loop (GLSL ES / ANGLE D3D11 safe)
    // Tap offsets span [-0.5, +0.5] along iVelocity; tent weight = 1.0 - |offset| * 1.2
    for (int i = 0; i < 13; i++) {
        float offset = (float(i) / 12.0) - 0.5;
        float w = max(0.0, 1.0 - abs(offset) * 1.2);
        accum += content.eval(fragCoord + iVelocity * offset) * half(w);
        weightSum += w;
    }

    return accum / half(weightSum);
}
