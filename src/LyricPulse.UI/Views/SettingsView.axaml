<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LyricPulse.UI.ViewModels"
             xmlns:m="clr-namespace:LyricPulse.Core.Models;assembly=LyricPulse.Core"
             x:Class="LyricPulse.UI.Views.SettingsView"
             x:DataType="vm:StageViewModel"
             Background="{DynamicResource LpGlassDrawerBrush}"
             BorderBrush="{DynamicResource LpGlassChromeBorderBrush}"
             BorderThickness="1,0,0,0"
             FontFamily="{DynamicResource LpFontUi}">
  <UserControl.Styles>
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="{DynamicResource LpGlassTileBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LpTextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LpGlassTileBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LpGlassTileHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LpTextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LpGlassTileBorderHoverBrush}"/>
    </Style>
    <Style Selector="Button.seg.active">
      <Setter Property="Background" Value="{DynamicResource LpAccentSoftBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LpAccentTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LpAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LpAccentSoftBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LpTextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LpAccentBorderBrush}"/>
    </Style>
    <Style Selector="Button.glass-close">
      <Setter Property="Background" Value="{DynamicResource LpGlassTileBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LpGlassTileBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.glass-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LpGlassTileHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LpGlassTileBorderHoverBrush}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="54,*,56">
    <!-- Sticky Glass Header -->
    <Border Grid.Row="0"
            Padding="20,0,12,0"
            Background="{DynamicResource LpGlassTileBrush}"
            BorderBrush="{DynamicResource LpGlassDividerBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Studio Settings"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource LpFontDisplay}"
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="{DynamicResource LpTextPrimaryBrush}"/>
        <Button Classes="glass-close"
                Grid.Column="1"
                Width="36" Height="36"
                Command="{Binding ToggleSettingsDrawerCommand}"
                ToolTip.Tip="Close (Esc)"
                AutomationProperties.Name="Close Settings">
          <PathIcon Data="{StaticResource LpIconDismiss}"
                    Width="15" Height="15"
                    Foreground="{DynamicResource LpTextPrimaryBrush}"/>
        </Button>
      </Grid>
    </Border>

    <!-- Scrollable Body -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,16,20,24" Spacing="20">

        <!-- 1. Typography (10 Studio Typefaces) -->
        <StackPanel Spacing="10">
          <TextBlock Text="Typography" FontFamily="{StaticResource LpFontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <Button Classes="seg" Classes.active="{Binding IsJostSelected}" Grid.Row="0" Grid.Column="0"
                    Command="{Binding SelectFontCommand}" CommandParameter="Jost"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontJost}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Jost" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Geometric sans" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsBodoniSelected}" Grid.Row="0" Grid.Column="1"
                    Command="{Binding SelectFontCommand}" CommandParameter="Bodoni Moda"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontBodoni}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Bodoni Moda" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Editorial serif" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsMulishSelected}" Grid.Row="1" Grid.Column="0"
                    Command="{Binding SelectFontCommand}" CommandParameter="Mulish"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontMulish}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Mulish" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Clean humanist" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsNunitoSelected}" Grid.Row="1" Grid.Column="1"
                    Command="{Binding SelectFontCommand}" CommandParameter="Nunito"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontNunito}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Nunito" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Rounded soft" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsBahnschriftSelected}" Grid.Row="2" Grid.Column="0"
                    Command="{Binding SelectFontCommand}" CommandParameter="Bahnschrift"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontBahnschrift}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Bahnschrift" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Industrial DIN" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsGeorgiaSelected}" Grid.Row="2" Grid.Column="1"
                    Command="{Binding SelectFontCommand}" CommandParameter="Georgia"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontGeorgia}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Georgia" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Classic serif" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsImpactSelected}" Grid.Row="3" Grid.Column="0"
                    Command="{Binding SelectFontCommand}" CommandParameter="Impact"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontImpact}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Impact" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Poster heavy" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsSitkaDisplaySelected}" Grid.Row="3" Grid.Column="1"
                    Command="{Binding SelectFontCommand}" CommandParameter="Sitka Display"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontSitka}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Sitka Display" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Lyric serif" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsInkFreeSelected}" Grid.Row="4" Grid.Column="0"
                    Command="{Binding SelectFontCommand}" CommandParameter="Ink Free"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontInkFree}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Ink Free" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Handwritten" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Classes="seg" Classes.active="{Binding IsCascadiaMonoSelected}" Grid.Row="4" Grid.Column="1"
                    Command="{Binding SelectFontCommand}" CommandParameter="Cascadia Mono"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="9,7">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource LpGlassTileBrush}" BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <TextBlock Text="Aa" FontFamily="{StaticResource LpFontMono}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Cascadia" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  <TextBlock Text="Studio mono" FontSize="10.5" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Text="Codestyle uses monospace and Messages uses system chat typography."
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource LpTextTertiaryBrush}"/>

          <!-- Lyric Scale -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <TextBlock Text="Lyric Scale" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding FontScalePercent, StringFormat='{}{0}%'}"
                       FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                       Foreground="{DynamicResource LpAccentTextBrush}"/>
          </Grid>
          <Slider Minimum="60" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding FontScalePercent}"
                  AutomationProperties.Name="Lyric text scale percentage"/>

          <!-- Fullscreen Hero Stage Scale -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Stage Hero Size" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding FullscreenStageScalePercent, StringFormat='{}{0}%'}"
                       FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                       Foreground="{DynamicResource LpAccentTextBrush}"/>
          </Grid>
          <Slider Minimum="120" Maximum="260" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding FullscreenStageScalePercent}"
                  AutomationProperties.Name="Stage hero typography scale"/>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource LpGlassDividerBrush}"/>

        <!-- 2. Aesthetics & Color -->
        <StackPanel Spacing="10">
          <TextBlock Text="Aesthetics &amp; Color" FontFamily="{StaticResource LpFontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Classes="seg" Classes.active="{Binding IsAlbumArtBackdrop}" Grid.Column="0"
                    Command="{Binding SelectBackdropModeCommand}" CommandParameter="{x:Static m:StageBackdropMode.AlbumArtBlur}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,8"
                    Content="Album Art" FontSize="12" FontWeight="SemiBold"/>
            <Button Classes="seg" Classes.active="{Binding IsPureBlackBackdrop}" Grid.Column="1"
                    Command="{Binding SelectBackdropModeCommand}" CommandParameter="{x:Static m:StageBackdropMode.PureBlack}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,8"
                    Content="Pure Black" FontSize="12" FontWeight="SemiBold"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Color-Changing Sweep Layer" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowColorSweepLayer}" OnContent="" OffContent=""/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Party Motion Energy" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding PartyEnergyPercent, StringFormat='{}{0}%'}"
                       FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                       Foreground="{DynamicResource LpAccentTextBrush}"/>
          </Grid>
          <Slider Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding PartyEnergyPercent}"
                  AutomationProperties.Name="Party animation energy"/>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Auto-Sync Album Colors" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoSyncColors}" OnContent="" OffContent=""/>
          </Grid>

          <!-- Manual 3-Accent ColorPickers (visible when Auto-Sync is off) -->
          <StackPanel Spacing="8" IsVisible="{Binding !AutoSyncColors}">
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="Accent 1 (Primary Sung)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
              <ColorPicker Grid.Column="1" Color="{Binding ManualColor1, Mode=TwoWay}" IsAlphaEnabled="False" Height="32"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="Accent 2 (Glow / Icons)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
              <ColorPicker Grid.Column="1" Color="{Binding ManualColor2, Mode=TwoWay}" IsAlphaEnabled="False" Height="32"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="Accent 3 (Ambient / Context)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
              <ColorPicker Grid.Column="1" Color="{Binding ManualColor3, Mode=TwoWay}" IsAlphaEnabled="False" Height="32"/>
            </Grid>

            <!-- 4 Studio Presets -->
            <TextBlock Text="Quick Studio Presets" FontSize="12" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
            <ItemsControl ItemsSource="{Binding StudioPresets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColorPresetOption">
                  <Button Margin="0,0,6,6" Padding="10,6" CornerRadius="8" Cursor="Hand"
                          Background="{DynamicResource LpSurfaceElevatedBrush}"
                          Command="{Binding $parent[UserControl].((vm:StageViewModel)DataContext).ApplyColorPresetCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Bilingual Sub-line -->
          <TextBlock Text="Bilingual Sub-line" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Classes="seg" Classes.active="{Binding IsSecondaryOff}" Grid.Column="0" Content="Off" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectSecondaryLineCommand}" CommandParameter="{x:Static m:SecondaryLineMode.Off}"/>
            <Button Classes="seg" Classes.active="{Binding IsSecondaryTranslation}" Grid.Column="1" Content="Translate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectSecondaryLineCommand}" CommandParameter="{x:Static m:SecondaryLineMode.Translation}"/>
            <Button Classes="seg" Classes.active="{Binding IsSecondaryRomanization}" Grid.Column="2" Content="Romanize" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectSecondaryLineCommand}" CommandParameter="{x:Static m:SecondaryLineMode.Romanization}"/>
          </Grid>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource LpGlassDividerBrush}"/>

        <!-- 2B. Audio Visualizer & Edges Glow -->
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Audio Visualizer &amp; Edges Glow" VerticalAlignment="Center" FontFamily="{StaticResource LpFontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <Border Grid.Column="1" Padding="8,3" CornerRadius="999" Background="{DynamicResource LpAccentSoftBgBrush}" BorderBrush="{DynamicResource LpAccentBorderBrush}" BorderThickness="1">
              <TextBlock Text="{Binding AudioStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LpAccentTextBrush}"/>
            </Border>
          </Grid>

          <TextBlock Text="Background Audio Visualizer" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
            <Button Classes="seg" Classes.active="{Binding IsVisNone}" Grid.Row="0" Grid.Column="0" Content="Off" FontSize="11" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectAudioVisualizerModeCommand}" CommandParameter="{x:Static m:AudioVisualizerMode.None}"/>
            <Button Classes="seg" Classes.active="{Binding IsVisSpectrumBars}" Grid.Row="0" Grid.Column="1" Content="Spectrum" FontSize="11" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectAudioVisualizerModeCommand}" CommandParameter="{x:Static m:AudioVisualizerMode.SpectrumBars}"/>
            <Button Classes="seg" Classes.active="{Binding IsVisRadialHalo}" Grid.Row="0" Grid.Column="2" Content="Halo" FontSize="11" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectAudioVisualizerModeCommand}" CommandParameter="{x:Static m:AudioVisualizerMode.RadialHalo}"/>
            <Button Classes="seg" Classes.active="{Binding IsVisFluidWave}" Grid.Row="1" Grid.Column="0" Content="Fluid Wave" FontSize="11" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectAudioVisualizerModeCommand}" CommandParameter="{x:Static m:AudioVisualizerMode.FluidWave}"/>
            <Button Classes="seg" Classes.active="{Binding IsVisParticleField}" Grid.Row="1" Grid.Column="1" Content="Particles" FontSize="11" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectAudioVisualizerModeCommand}" CommandParameter="{x:Static m:AudioVisualizerMode.ParticleField}"/>
            <Button Classes="seg" Classes.active="{Binding IsVisBassHorizon}" Grid.Row="1" Grid.Column="2" Content="Horizon" FontSize="11" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectAudioVisualizerModeCommand}" CommandParameter="{x:Static m:AudioVisualizerMode.BassHorizon}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Visualizer Intensity" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding AudioVisualizerIntensityPercent, StringFormat='{}{0}%'}"
                       FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                       Foreground="{DynamicResource LpAccentTextBrush}"/>
          </Grid>
          <Slider Minimum="20" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding AudioVisualizerIntensityPercent}"
                  AutomationProperties.Name="Audio visualizer intensity"/>

          <TextBlock Text="Edges Glow" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
            <Button Classes="seg" Classes.active="{Binding IsEdgeGlowOff}" Grid.Row="0" Grid.Column="0" Content="Off" FontSize="11" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectEdgeGlowModeCommand}" CommandParameter="{x:Static m:EdgeGlowMode.Off}"/>
            <Button Classes="seg" Classes.active="{Binding IsEdgeGlowSoftAmbient}" Grid.Row="0" Grid.Column="1" Content="Ambient" FontSize="11" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectEdgeGlowModeCommand}" CommandParameter="{x:Static m:EdgeGlowMode.SoftAmbient}"/>
            <Button Classes="seg" Classes.active="{Binding IsEdgeGlowBeatPulse}" Grid.Row="0" Grid.Column="2" Content="Pulse" FontSize="11" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectEdgeGlowModeCommand}" CommandParameter="{x:Static m:EdgeGlowMode.BeatPulse}"/>
            <Button Classes="seg" Classes.active="{Binding IsEdgeGlowNeonRim}" Grid.Row="1" Grid.Column="0" Content="Neon Rim" FontSize="11" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectEdgeGlowModeCommand}" CommandParameter="{x:Static m:EdgeGlowMode.NeonRim}"/>
            <Button Classes="seg" Classes.active="{Binding IsEdgeGlowNeonRush}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="Neon Rush" FontSize="11" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectEdgeGlowModeCommand}" CommandParameter="{x:Static m:EdgeGlowMode.NeonRush}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Edges Glow Intensity" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding EdgeGlowIntensityPercent, StringFormat='{}{0}%'}"
                       FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                       Foreground="{DynamicResource LpAccentTextBrush}"/>
          </Grid>
          <Slider Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding EdgeGlowIntensityPercent}"
                  AutomationProperties.Name="Edges glow intensity"/>

          <StackPanel IsVisible="{Binding IsEdgeGlowActive}" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="System-Wide Monitor Glow (Lumn Mode)" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                <TextBlock Text="Illuminate Windows display edges even with lyrics off" FontSize="11" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EdgeGlowDesktopEnabled}" OnContent="" OffContent=""/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="2-Color Gradient (60% / 40%)" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EdgeGlowTwoColorGradient}" OnContent="" OffContent=""/>
            </Grid>

            <TextBlock Text="Glow Animation" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <Button Classes="seg" Classes.active="{Binding IsEdgeGlowAnimMusicSync}" Grid.Column="0" Content="Music Sync" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding SelectEdgeGlowAnimationCommand}" CommandParameter="{x:Static m:EdgeGlowAnimationMode.MusicSync}"/>
              <Button Classes="seg" Classes.active="{Binding IsEdgeGlowAnimAmbientDrift}" Grid.Column="1" Content="Drift" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding SelectEdgeGlowAnimationCommand}" CommandParameter="{x:Static m:EdgeGlowAnimationMode.AmbientDrift}"/>
              <Button Classes="seg" Classes.active="{Binding IsEdgeGlowAnimStill}" Grid.Column="2" Content="Still" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding SelectEdgeGlowAnimationCommand}" CommandParameter="{x:Static m:EdgeGlowAnimationMode.Still}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Glow Thickness &amp; Depth" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding EdgeGlowThicknessPercent, StringFormat='{}{0}%'}"
                         FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                         Foreground="{DynamicResource LpAccentTextBrush}"/>
            </Grid>
            <Slider Minimum="40" Maximum="250" TickFrequency="5" IsSnapToTickEnabled="True"
                    Value="{Binding EdgeGlowThicknessPercent}"
                    AutomationProperties.Name="Edge glow thickness"/>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Inward Glow Spill" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding EdgeGlowSpillPercent, StringFormat='{}{0}%'}"
                         FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                         Foreground="{DynamicResource LpAccentTextBrush}"/>
            </Grid>
            <Slider Minimum="25" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                    Value="{Binding EdgeGlowSpillPercent}"
                    AutomationProperties.Name="Inward glow spill"/>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Override Album Colors (Edge Glow)" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EdgeGlowOverrideAlbumColors}" OnContent="" OffContent=""/>
            </Grid>

            <StackPanel IsVisible="{Binding EdgeGlowOverrideAlbumColors}" Spacing="8">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="Edge Primary Color (60%)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
                <ColorPicker Grid.Column="1" Color="{Binding EdgeGlowPrimaryColor, Mode=TwoWay}" IsAlphaEnabled="False" Height="32"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EdgeGlowTwoColorGradient}" Margin="0,2">
                <TextBlock Text="Edge Secondary Color (40%)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
                <ColorPicker Grid.Column="1" Color="{Binding EdgeGlowSecondaryColor, Mode=TwoWay}" IsAlphaEnabled="False" Height="32"/>
              </Grid>
            </StackPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsEdgeGlowNeonRush}" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Neon Rush Speed" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding EdgeGlowSpeedPercent, StringFormat='{}{0}%'}"
                         FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                         Foreground="{DynamicResource LpAccentTextBrush}"/>
            </Grid>
            <Slider Minimum="20" Maximum="250" TickFrequency="5" IsSnapToTickEnabled="True"
                    Value="{Binding EdgeGlowSpeedPercent}"
                    AutomationProperties.Name="Neon Rush speed"/>
          </StackPanel>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource LpGlassDividerBrush}"/>

        <!-- 3. Screen, Desktop Overlay & Displays -->
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Displays &amp; Desktop Overlay" VerticalAlignment="Center" FontFamily="{StaticResource LpFontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <Button Classes="glass-close" Grid.Column="1" Width="34" Height="34"
                    Command="{Binding RefreshDisplaysCommand}" ToolTip.Tip="Refresh Displays"
                    AutomationProperties.Name="Refresh displays">
              <PathIcon Data="{StaticResource LpIconRefresh}" Width="15" Height="15" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Transparent Desktop Overlay" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
              <TextBlock Text="Click-through lyrics over other apps" FontSize="11" Foreground="{DynamicResource LpTextTertiaryBrush}"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding DesktopOverlayEnabled}" OnContent="" OffContent=""/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Overlay Opacity" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding OverlayOpacityPercent, StringFormat='{}{0}%'}"
                       FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                       Foreground="{DynamicResource LpAccentTextBrush}"/>
          </Grid>
          <Slider Minimum="25" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding OverlayOpacityPercent}"/>

          <!-- 5-Zone Safe Anchor Grid -->
          <TextBlock Text="Overlay Safe Position" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
          <Border Background="{DynamicResource LpStageBackgroundBrush}" BorderBrush="{DynamicResource LpBorderStrongBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="8" Height="96">
            <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*,*,*">
              <Button Classes="seg" Classes.active="{Binding IsAnchorTopCenter}" Grid.Row="0" Grid.Column="1" Content="Top" FontSize="11" HorizontalAlignment="Center" Padding="10,3"
                      Command="{Binding SelectAnchorZoneCommand}" CommandParameter="{x:Static m:AnchorZone.TopCenter}"/>
              <Button Classes="seg" Classes.active="{Binding IsAnchorMiddleCenter}" Grid.Row="1" Grid.Column="1" Content="Center" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,3"
                      Command="{Binding SelectAnchorZoneCommand}" CommandParameter="{x:Static m:AnchorZone.MiddleCenter}"/>
              <Button Classes="seg" Classes.active="{Binding IsAnchorBottomLeft}" Grid.Row="2" Grid.Column="0" Content="B-Left" FontSize="11" HorizontalAlignment="Left" Padding="8,3"
                      Command="{Binding SelectAnchorZoneCommand}" CommandParameter="{x:Static m:AnchorZone.BottomLeft}"/>
              <Button Classes="seg" Classes.active="{Binding IsAnchorBottomThird}" Grid.Row="2" Grid.Column="1" Content="B-Third" FontSize="11" HorizontalAlignment="Center" Padding="8,3"
                      Command="{Binding SelectAnchorZoneCommand}" CommandParameter="{x:Static m:AnchorZone.BottomThird}"/>
              <Button Classes="seg" Classes.active="{Binding IsAnchorBottomRight}" Grid.Row="2" Grid.Column="2" Content="B-Right" FontSize="11" HorizontalAlignment="Right" Padding="8,3"
                      Command="{Binding SelectAnchorZoneCommand}" CommandParameter="{x:Static m:AnchorZone.BottomRight}"/>
              <Border Grid.Row="3" Grid.ColumnSpan="3" Height="3" Margin="0,4,0,0" CornerRadius="2" Background="{DynamicResource LpBorderDefaultBrush}"/>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Taskbar Safe Margin" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding SafeMarginPx, StringFormat='{}{0} px'}"
                       FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum" FontSize="12"
                       Foreground="{DynamicResource LpTextSecondaryBrush}"/>
          </Grid>
          <Slider Minimum="16" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding SafeMarginPx}"/>

          <!-- Monitor List -->
          <ItemsControl ItemsSource="{Binding Displays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DisplayOptionViewModel">
                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="9"
                        Background="{DynamicResource LpGlassTileBrush}"
                        BorderBrush="{DynamicResource LpGlassTileBorderBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding HeaderText}" FontSize="12" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                      <TextBlock Text="{Binding TelemetryText}" FontSize="11"
                                 FontFamily="{StaticResource LpFontMono}" FontFeatures="tnum"
                                 Foreground="{DynamicResource LpTextSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border IsVisible="{Binding AllDisplaysDisabled}" Padding="10" CornerRadius="9"
                  Background="{DynamicResource LpWarningSoftBgBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Overlay disabled on all displays." VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Foreground="{DynamicResource LpWarningTextBrush}"/>
              <Button Classes="seg" Grid.Column="1" Content="Enable Primary" Command="{Binding EnablePrimaryDisplayCommand}"/>
            </Grid>
          </Border>

          <Button Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" CornerRadius="9"
                  Command="{Binding ToggleObsWindowCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource LpIconBroadcast}" Width="16" Height="16"/>
              <TextBlock Text="OBS Chroma-Key Capture Window" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource LpGlassDividerBrush}"/>

        <!-- 4. Theme, Media & Accessibility -->
        <StackPanel Spacing="10">
          <TextBlock Text="Theme &amp; Accessibility" FontFamily="{StaticResource LpFontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Classes="seg" Classes.active="{Binding IsThemeSystem}" Grid.Column="0" Content="System" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectThemeVariantCommand}" CommandParameter="{x:Static m:ThemeVariantMode.System}"/>
            <Button Classes="seg" Classes.active="{Binding IsThemeDark}" Grid.Column="1" Content="Dark" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectThemeVariantCommand}" CommandParameter="{x:Static m:ThemeVariantMode.Dark}"/>
            <Button Classes="seg" Classes.active="{Binding IsThemeLight}" Grid.Column="2" Content="Light" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectThemeVariantCommand}" CommandParameter="{x:Static m:ThemeVariantMode.Light}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Follow All Media Players" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding UniversalPlayerMode}" OnContent="" OffContent=""/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Auto-Hide in Fullscreen Games" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideDuringFullscreen}" OnContent="" OffContent=""/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Reduced Motion" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
              <TextBlock IsVisible="{Binding IsOsReducedMotion}" Text="Synced with Windows setting"
                         FontSize="11" Foreground="{DynamicResource LpAccentTextBrush}"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReducedMotion}" IsEnabled="{Binding IsReducedMotionToggleEnabled}" OnContent="" OffContent=""/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="High-Contrast Text Scrim" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HighContrastScrim}" OnContent="" OffContent=""/>
          </Grid>

          <TextBlock Text="Ambient Scrim Intensity" FontSize="12" Foreground="{DynamicResource LpTextSecondaryBrush}"/>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
            <Button Classes="seg" Classes.active="{Binding IsScrimOff}" Grid.Column="0" Content="Off" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectScrimIntensityCommand}" CommandParameter="{x:Static m:ScrimIntensity.Off}"/>
            <Button Classes="seg" Classes.active="{Binding IsScrimSubtle}" Grid.Column="1" Content="Subtle" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectScrimIntensityCommand}" CommandParameter="{x:Static m:ScrimIntensity.Subtle}"/>
            <Button Classes="seg" Classes.active="{Binding IsScrimBalanced}" Grid.Column="2" Content="Balanced" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectScrimIntensityCommand}" CommandParameter="{x:Static m:ScrimIntensity.Balanced}"/>
            <Button Classes="seg" Classes.active="{Binding IsScrimStrong}" Grid.Column="3" Content="Strong" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SelectScrimIntensityCommand}" CommandParameter="{x:Static m:ScrimIntensity.Strong}"/>
          </Grid>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource LpGlassDividerBrush}"/>

        <!-- 5. Global Hotkeys -->
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Global Hotkeys" VerticalAlignment="Center" FontFamily="{StaticResource LpFontDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
            <Button Classes="seg" Grid.Column="1" Content="Reset" FontSize="11" Padding="10,4" Command="{Binding ResetHotkeysCommand}"/>
          </Grid>

          <ItemsControl ItemsSource="{Binding HotkeyRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HotkeyBindingViewModel">
                <StackPanel Margin="0,0,0,6" Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LpTextPrimaryBrush}"/>
                    <Button Classes="seg" Grid.Column="1" MinHeight="30" Padding="10,4" CornerRadius="7" Cursor="Hand"
                            Content="{Binding DisplayButtonText}"
                            FontFamily="{StaticResource LpFontMono}" FontSize="11"
                            Command="{Binding BeginRecordCommand}" CommandParameter="{Binding Action}"/>
                  </Grid>
                  <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}"
                             FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LpDangerTextBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Sticky Glass Footer with 2-Step Reset -->
    <Border Grid.Row="2"
            Padding="20,8"
            Background="{DynamicResource LpGlassTileBrush}"
            BorderBrush="{DynamicResource LpGlassDividerBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="LyricPulse · Studio Glass" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource LpTextTertiaryBrush}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="seg" IsVisible="{Binding !IsResetConfirmArmed}"
                  Content="Reset Defaults" Padding="12,6"
                  Command="{Binding ArmResetCommand}"/>
          <Button IsVisible="{Binding IsResetConfirmArmed}"
                  Content="Confirm Reset" Padding="12,6" CornerRadius="8"
                  Background="{DynamicResource LpDangerBrush}"
                  Foreground="{DynamicResource LpOnDangerBrush}"
                  Command="{Binding ConfirmResetCommand}"/>
          <Button Classes="seg" IsVisible="{Binding IsResetConfirmArmed}"
                  Content="Cancel" Padding="12,6"
                  Command="{Binding CancelResetCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
